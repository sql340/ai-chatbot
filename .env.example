# HTTP
APP_NAME=AI Customer Service
APP_HOST=0.0.0.0
APP_PORT=8000
CORS_ORIGINS=

# Main generation model (OpenAI-compatible Chat Completions)
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4.1-mini
LLM_TEMPERATURE=0.3
LLM_MAX_TOKENS=800
LLM_TIMEOUT=60
LLM_MAX_RETRIES=2

# Quality / naturalness judge. Reserved for the next phase.
QUALITY_LLM_BASE_URL=
QUALITY_LLM_API_KEY=
QUALITY_LLM_MODEL=
QUALITY_LLM_TEMPERATURE=0

# Embedding. Reserved for future direct indexing or retrieval integration.
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=

# Session state
SESSION_BACKEND=redis
REDIS_URL=redis://localhost:6379/0
REDIS_KEY_PREFIX=ai-chatbot
SESSION_TTL_SECONDS=1800
SESSION_LOCK_TTL_MS=120000
SESSION_LOCK_WAIT_SECONDS=2

# Agent behaviour
MAX_TURNS=12
MAX_HISTORY_MESSAGES=30
REPLY_MAX_CHARS=500

# Optional RAG. The adapter reads the `sources` event from enterprise-rag /v1/query.
RAG_ENABLED=false
RAG_BASE_URL=http://localhost:8080
RAG_TIMEOUT=30
RAG_TOP_K=4
RAG_TENANT_FIELD=tenant_id
RAG_SCORE_THRESHOLD=

# Reserved: important routing/choice decisions can be delegated to Jev later.
DECISION_ENGINE=disabled
JEV_BASE_URL=
JEV_API_KEY=
JEV_MODEL=

# Channels
CHANNEL_EVENT_DEDUPE_TTL_SECONDS=3600
WEB_ENABLED=true

# Feishu self-built app. Set FEISHU_ENCRYPT_KEY in production to verify signatures.
FEISHU_ENABLED=false
FEISHU_TENANT_ID=default
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_ENCRYPT_KEY=
FEISHU_VERIFICATION_TOKEN=
FEISHU_API_BASE_URL=https://open.feishu.cn
FEISHU_TIMEOUT=10

# QQ via OneBot 11 HTTP API (NapCat / go-cqhttp compatible)
QQ_ENABLED=false
QQ_TENANT_ID=default
QQ_ONEBOT_API_BASE_URL=http://localhost:3000
QQ_ONEBOT_ACCESS_TOKEN=
QQ_TIMEOUT=10

# WeChat Official Account callback. Set the AES key to require safe mode.
WECHAT_ENABLED=false
WECHAT_TENANT_ID=default
WECHAT_TOKEN=
WECHAT_ENCODING_AES_KEY=
WECHAT_APP_ID=
WECHAT_APP_SECRET=
WECHAT_API_BASE_URL=https://api.weixin.qq.com
WECHAT_TIMEOUT=10

